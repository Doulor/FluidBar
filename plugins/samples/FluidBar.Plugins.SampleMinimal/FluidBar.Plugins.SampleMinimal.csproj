<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sample plugin (minimal). Build with `dotnet build plugins/samples/FluidBar.Plugins.SampleMinimal`.
    The SDK is compiled against but never copied into the output (Private=false): the host owns the
    single FluidBar.Sdk type identity.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FluidBar.Plugins.SampleMinimal</AssemblyName>
    <RootNamespace>FluidBar.Plugins.SampleMinimal</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FluidBar.Sdk\FluidBar.Sdk.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="locales\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
