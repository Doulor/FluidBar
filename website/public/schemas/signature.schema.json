{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidbar.doulor.cn/schemas/signature.schema.json",
  "title": "FluidBar Detached Package Signature",
  "description": "Published next to the .fbp (never inside it). Covers package.sha256 with ECDSA P-256 signatures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "signatures"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 157286400 }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "role", "algorithm", "publicKey", "value", "signedAt"],
      "properties": {
        "keyId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "role": { "enum": ["author", "marketplace"] },
        "algorithm": { "enum": ["ECDSA-P256-SHA256", "Ed25519"] },
        "publicKey": { "type": "string", "minLength": 32 },
        "value": { "type": "string", "minLength": 32 },
        "signedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
