{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidbar.doulor.cn/schemas/app-locale.schema.json",
  "title": "FluidBar App Locale Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "version",
    "messages"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"
    },
    "version": {
      "const": 1
    },
    "messages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  }
}
