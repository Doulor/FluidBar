<Project Sdk="Microsoft.NET.Sdk">

  <!-- M0 local-channel sample: registers a host-rendered seventh page (list template). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FluidBar.Sample.LocalPages</AssemblyName>
    <RootNamespace>FluidBar.Sample.LocalPages</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluidBar.Sdk\FluidBar.Sdk.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="locales\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
