<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Soak harness console code: CA1707/CA1303/CA2007/CA1822/CA1861 are harness noise;
         CA1031 is deliberate at the scenario boundary (a scenario failure must be reported, not crash). -->
    <NoWarn>$(NoWarn);CA1707;CA1303;CA2007;CA1822;CA1861;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluidBar.Core\FluidBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*.json" />
    <None Update="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
