<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Marketplace evidence harness (developer/QA tool, not shipped): builds a real .fbp from the compiled
    sample plugin, drives the full local-marketplace flow (submit → review → install → download counter →
    rating → restart read-back) against a scratch marketplace/plugins root, then renders the real settings
    window (marketplace section) to PNG so the UI evidence matches the real data.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>false</UseWindowsForms>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FluidBar.Marketplace.Evidence</RootNamespace>
    <AssemblyName>FluidBar.Marketplace.Evidence</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluidBar.App\FluidBar.App.csproj" />
    <ProjectReference Include="..\..\src\FluidBar.Marketplace\FluidBar.Marketplace.csproj" />
  </ItemGroup>

</Project>
